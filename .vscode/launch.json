{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            // You need to enable QGIS VSCode debugger plugin
            // Before this will work
            "name": "🐞 Attach Debug Client",
            "type": "debugpy",
            "request": "attach",
            "connect": {
              "port": 5678,
              "host": "127.0.0.1",
            },
            "justMyCode": true
        },
        {
            "name": "📦 Deploy",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/deploy.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
        },
        {
            "name": "🧪 Test Analysis Metrics",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/test/test_analysis_metrics.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/..;${env:PYTHONPATH}"
            }
        },
        {
            "name": "🧪 Test Help Links",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/test/test_help_links.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/..;${env:PYTHONPATH}"
            }
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
