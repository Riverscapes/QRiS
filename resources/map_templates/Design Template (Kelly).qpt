 <LayoutItem labelText="Mid-channel PALS are built by placing woody pieces in the center of the active channel to promote divergent flow paths. This structure type generally covers 50-60% of the active channel. No reinforcement materials (cobble, gravel, soil, etc) will be used in the construction of PALS; only vegetation from local sources." visibility="1" htmlState="0" frame="false" marginY="0" zValue="35" id="" opacity="1" size="10.6413,1.34632,in" type="65641" templateUuid="{f21ab92e-c40d-4888-93cd-1e8403e31ea7}" halign="1" referencePoint="0" outlineWidthM="0.3,mm" marginX="2" frameJoinStyle="miter" itemRotation="0" valign="32" uuid="{f21ab92e-c40d-4888-93cd-1e8403e31ea7}" position="13.231,13.7639,in" blendMode="0" positionOnPage="13.231,13.7639,in" excludeFromExports="0" groupUuid="" background="false" positionLock="true">
