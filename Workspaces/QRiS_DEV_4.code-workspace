{
  "folders": [
    {
      "path": ".."
    }
  ],
  "settings": {
    // FROM: https://gist.github.com/NicolaiMogensen/acfd8723720c4761aefef3cdfc2aa55a
    // I like changing colors for my projects. QGIS projects are usually green.
    "workbench.colorCustomizations": {
      "titleBar.activeForeground": "#ffffff",
      "titleBar.activeBackground": "#b4b4b473",
      // "editor.background": "#1c2c2a"
    },
    "terminal.integrated.env.osx": {
      "PYTHONPATH": "${env:QGIS_PATH}/Contents/Resources/python:${env:QGIS_PATH}/Contents/Resources/python/site-packages:${env:QGIS_PATH}/Contents/Resources/python/site-packages/PyQt6:${workspaceFolder}/wheels",
      "PATH": "${env:PATH}:${env:QGIS_PATH}/Contents/MacOS/bin"
    },
    "terminal.integrated.env.windows": {
      "PYTHONPATH": "${env:OSGEO4W_ROOT}/apps/qgis/python;${env:OSGEO4W_ROOT}/apps/qgis/python/plugins;${env:OSGEO4W_ROOT}/apps/Python312/Lib/site-packages",
      "PATH": "${env:PATH};${env:OSGEO4W_ROOT}/bin;${env:OSGEO4W_ROOT}/apps/Python312/Scripts;${env:OSGEO4W_ROOT}/apps/qt6/bin;${env:OSGEO4W_ROOT}/apps/qgis/bin"
    },
    "terminal.integrated.defaultProfile.linux": "zsh"
  }
}
